<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Farmacia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/styles.css" rel="stylesheet">
</head>
<body>
<% const rol = user ? user.role : null;
   const act = typeof activo !== 'undefined' ? activo : '';
   const etiquetaRol = { administrador: 'Administrador', moderador: 'Moderador', usuario: 'Usuario' }; %>
<nav class="navbar navbar-expand-lg navbar-farmacia" data-bs-theme="dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="<%= user ? '/menu' : '/login' %>">
            <i class="bi bi-capsule-pill"></i> Farmacia
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNav" aria-label="Abrir menú">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuNav">
            <% if (user) { %>
            <!-- La barra cambia automaticamente segun el rol del usuario -->
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link <%= act === 'menu' ? 'active' : '' %>" href="/menu">Inicio</a></li>
                <% menuNav.forEach(function (s) { const activa = s.items.some(function (i) { return i.clave === act; }); %>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle <%= activa ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= s.titulo %></a>
                    <ul class="dropdown-menu">
                        <% s.items.forEach(function (i) { %>
                        <li><a class="dropdown-item <%= act === i.clave ? 'active' : '' %>" href="/<%= i.clave %>"><%= i.titulo %></a></li>
                        <% }); %>
                    </ul>
                </li>
                <% }); %>
                <% if (rol === 'administrador') { %>
                <li class="nav-item"><a class="nav-link <%= act === 'usuarios' ? 'active' : '' %>" href="/usuarios">Usuarios</a></li>
                <% } %>
            </ul>
            <div class="d-flex align-items-center gap-3 text-white">
                <span class="small"><i class="bi bi-person-circle"></i> <%= user.nombre %>
                    <span class="badge rol-<%= rol %> ms-1"><%= etiquetaRol[rol] %></span>
                </span>
                <button id="btnLogout" class="btn btn-sm btn-outline-light">Cerrar sesión</button>
            </div>
            <% } else { %>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/login">Iniciar sesión</a></li>
                <li class="nav-item"><a class="nav-link" href="/register">Registrarse</a></li>
            </ul>
            <% } %>
        </div>
    </div>
</nav>
