<%- include('partials/header') %>
<main class="container py-4">
    <h1 class="h3 mb-3">Usuarios</h1>
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-farmacia align-middle mb-0">
                <thead><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Rol</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    <% usuarios.forEach(function (u) { const yo = u.id === user.id; %>
                    <tr>
                        <td><%= u.id %></td>
                        <td class="fw-semibold"><%= u.nombre %><% if (yo) { %> <span class="badge text-bg-secondary">tú</span><% } %></td>
                        <td><%= u.email %></td>
                        <td style="max-width:200px">
                            <select class="form-select form-select-sm sel-rol" data-id="<%= u.id %>" <%= yo ? 'disabled' : '' %>>
                                <% ROLES.forEach(function (r) { %>
                                <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r %></option>
                                <% }); %>
                            </select>
                        </td>
                        <td class="text-end">
                            <% if (!yo) { %>
                            <button class="btn btn-sm btn-outline-danger btn-del" title="Eliminar"
                                    data-id="<%= u.id %>" data-nombre="<%= u.nombre %>"><i class="bi bi-trash"></i></button>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</main>
<%- include('partials/footer', { scripts: ['/js/usuarios.js'] }) %>
