<%- include('partials/header') %>
<main class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0"><%= cfg.titulo %></h1>
        <div class="d-flex gap-2">
            <input type="search" id="buscar" class="form-control" placeholder="Buscar…" style="max-width:220px">
            <% if (puede.editar) { %>
            <button class="btn btn-danger text-nowrap" id="btnNuevo"><i class="bi bi-plus-lg"></i> Nuevo</button>
            <% } %>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-farmacia align-middle mb-0" id="tabla">
                <thead>
                    <tr>
                        <% cfg.columnas.forEach(function (c) { %><th class="<%= c.alinear === 'der' ? 'text-end' : '' %>"><%= c.label %></th><% }); %>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% filas.forEach(function (f) { %>
                    <tr>
                        <% cfg.columnas.forEach(function (c) { %><td class="<%= c.alinear === 'der' ? 'text-end' : '' %>"><%= valor(f, c) %></td><% }); %>
                        <td class="text-end text-nowrap">
                            <% if (cfg.detalle) { %>
                            <button class="btn btn-sm btn-outline-secondary btn-detalle" title="Ver detalle"
                                    data-id="<%= f[cfg.pk] %>"><i class="bi bi-list-ul"></i> Detalle</button>
                            <% } %>
                            <% if (puede.editar) { %>
                            <button class="btn btn-sm btn-outline-primary btn-edit" title="Editar"
                                    data-json="<%= JSON.stringify(f) %>"><i class="bi bi-pencil"></i></button>
                            <% } %>
                            <% if (puede.eliminar) { %>
                            <button class="btn btn-sm btn-outline-danger btn-del" title="Eliminar"
                                    data-id="<%= f[cfg.pk] %>" data-nombre="<%= valor(f, cfg.columnas[1] || cfg.columnas[0]) %>"><i class="bi bi-trash"></i></button>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                    <% if (!filas.length) { %>
                    <tr><td colspan="<%= cfg.columnas.length + 1 %>" class="text-center text-muted py-4">No hay registros.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<!-- Modal: crear / editar -->
<div class="modal fade" id="modalForm" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" id="formMain" novalidate>
            <div class="modal-header modal-header-farmacia">
                <h2 class="modal-title h5" id="tituloModal"></h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="alerta"></div>
                <div class="row g-3" id="camposMain"></div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-farmacia">Guardar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </form>
    </div>
</div>

<% if (cfg.detalle) { %>
<!-- Modal: detalle de la orden -->
<div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header modal-header-farmacia">
                <h2 class="modal-title h5" id="tituloDetalle"></h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive mb-3">
                    <table class="table table-farmacia align-middle mb-0">
                        <thead>
                            <tr>
                                <% cfg.detalle.columnas.forEach(function (c) { %><th class="<%= c.alinear === 'der' ? 'text-end' : '' %>"><%= c.label %></th><% }); %>
                                <% if (puede.editar) { %><th></th><% } %>
                            </tr>
                        </thead>
                        <tbody id="cuerpoDetalle"></tbody>
                        <% if (cfg.totalCampo) { %>
                        <tfoot><tr><th colspan="<%= cfg.detalle.columnas.length - 1 %>" class="text-end">Total</th><th class="text-end" id="totalDetalle"></th><% if (puede.editar) { %><th></th><% } %></tr></tfoot>
                        <% } %>
                    </table>
                </div>
                <% if (puede.editar) { %>
                <form id="formDetalle" novalidate>
                    <h3 class="h6 text-uppercase text-muted">Agregar medicamento</h3>
                    <div class="alert alert-danger d-none" id="alertaDetalle"></div>
                    <div class="row g-3 align-items-start" id="camposDetalle"></div>
                    <% if (cfg.detalle.monto) { %>
                    <p class="mt-3 mb-0 small text-muted" id="infoPrecio">Elige un medicamento: su precio unitario se toma automáticamente de Almacén.</p>
                    <% } %>
                    <button type="submit" class="btn btn-farmacia mt-3"><i class="bi bi-plus-lg"></i> Agregar</button>
                </form>
                <% } %>
            </div>
        </div>
    </div>
</div>
<% } %>

<script type="application/json" id="datos"><%- datosJson %></script>
<%- include('partials/footer', { scripts: ['/js/catalogo.js'] }) %>
